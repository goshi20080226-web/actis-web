{
  "rules": {
    "users": {
      ".read": "auth != null && auth.uid === 'ACTIS_15e1bbda2e5246729263'",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === 'ACTIS_15e1bbda2e5246729263')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'ACTIS_15e1bbda2e5246729263')"
      }
    },

    "sharedDatasets": {
      "$shareId": {
        ".read": true,
        ".write": "auth != null && (!data.exists() ? newData.child('ownerUid').val() === auth.uid : data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['ownerUid', 'dataset']) && newData.child('ownerUid').isString()"
      }
    }
  }
}
